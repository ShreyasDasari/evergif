# Generated by evergif (https://github.com/ShreyasDasari/evergif).
# Re-run evergif to regenerate; CI renders this file as-is.
Output demo/evergif.gif

Set Shell "bash"
Set FontSize 18
Set Width 1200
Set Height 360
Set Padding 24
Set Theme "Catppuccin Mocha"
Set TypingSpeed 45ms
Set Framerate 24
Set CursorBlink false
Env BASH_SILENCE_DEPRECATION_WARNING "1"

Hide
Type "export PS1='> ' PROMPT_COMMAND='' HISTFILE=/dev/null && clear"
Enter
Wait@10s
Show

Type "python3 greet.py --help"
Sleep 400ms
Enter
Wait@15s
Sleep 3s

Hide
Type "clear"
Enter
Wait@10s
Show

Type "python3 greet.py hello --name Ada --lang fr"
Sleep 400ms
Enter
Wait@15s
Sleep 3s

Hide
Type "clear"
Enter
Wait@10s
Show

Type "python3 greet.py hello --name Ada --shout"
Sleep 400ms
Enter
Wait@15s
Sleep 3s

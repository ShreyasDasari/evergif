name: evergif render

# Renders demo GIFs in CI so nobody needs vhs, ttyd, ffmpeg or Docker locally.
# Edit a tape, open a pull request, and the GIF is rendered and pushed back.
#
# This uses `pull_request`, never `pull_request_target`: a tape is executable
# content, and pull_request_target would run a stranger's commands with a
# write token and access to secrets. Pull requests from forks therefore get
# the rendered GIF as a downloadable artifact instead of a push.

on:
  pull_request:
    paths:
      - 'demo/*.tape'
  workflow_dispatch:
    inputs:
      demo:
        description: 'Demo name to render, or "all"'
        required: false
        default: 'all'

permissions:
  contents: write

concurrency:
  group: evergif-render-${{ github.head_ref || github.ref }}
  cancel-in-progress: true

env:
  VHS_NO_SANDBOX: 'true'

jobs:
  render:
    name: Render demo GIFs
    # Pinned, not ubuntu-latest: a runner image change would alter the
    # rendered pixels for everyone.
    runs-on: ubuntu-24.04
    steps:
      - uses: actions/checkout@v7
        with:
          ref: ${{ github.event.pull_request.head.ref || github.ref }}
          repository: ${{ github.event.pull_request.head.repo.full_name || github.repository }}
          fetch-depth: 0

      - name: Set up the project
        run: |
__EVERGIF_SETUP__

      - name: Which demos should be rendered?
        id: pick
        env:
          REQUESTED: ${{ inputs.demo }}
          BASE_REF: ${{ github.base_ref }}
        run: |
          set -uo pipefail
          if [ -n "${BASE_REF:-}" ]; then
            git fetch --quiet --depth=1 origin "$BASE_REF"
            changed=$(git diff --name-only "origin/$BASE_REF...HEAD" -- 'demo/*.tape' || true)
          elif [ "${REQUESTED:-all}" = 'all' ] || [ -z "${REQUESTED:-}" ]; then
            changed=$(ls demo/*.tape 2>/dev/null || true)
          else
            changed="demo/${REQUESTED}.tape"
          fi
          names=''
          for tape in $changed; do
            [ -f "$tape" ] || continue
            names="$names $(basename "$tape" .tape)"
          done
          if [ -z "$names" ]; then
            echo 'No tapes to render.'
          else
            echo "Rendering:$names"
          fi
          echo "names=${names# }" >> "$GITHUB_OUTPUT"

      - name: Install the render toolchain
        if: steps.pick.outputs.names != ''
        env:
          VHS_VERSION: '0.12.0'
          TTYD_VERSION: '1.7.7'
        run: |
          set -euo pipefail
          sudo apt-get update -qq
          sudo apt-get install -y -qq ffmpeg gifsicle fonts-jetbrains-mono
          curl -fsSL -o /tmp/ttyd \
            "https://github.com/tsl0922/ttyd/releases/download/${TTYD_VERSION}/ttyd.x86_64"
          sudo install -m 755 /tmp/ttyd /usr/local/bin/ttyd
          curl -fsSL -o /tmp/vhs.deb \
            "https://github.com/charmbracelet/vhs/releases/download/v${VHS_VERSION}/vhs_${VHS_VERSION}_amd64.deb"
          sudo dpkg -i /tmp/vhs.deb || sudo apt-get -f install -y -qq
          # vhs uses termenv, which strips colour when CI is set.
          echo 'CI=' >> "$GITHUB_ENV"
          echo 'COLORTERM=truecolor' >> "$GITHUB_ENV"
          vhs --version && ttyd --version

      - name: Render and optimize
        if: steps.pick.outputs.names != ''
        env:
          NAMES: ${{ steps.pick.outputs.names }}
        run: |
          set -euo pipefail
          for name in $NAMES; do
            vhs "demo/$name.tape"
            if [ ! -f "demo/$name.gif" ]; then
              echo "::error::vhs produced no GIF for demo '$name'"
              exit 1
            fi
            gifsicle -O3 --lossy=80 --colors 128 --no-comments --no-names \
              --no-extensions -b "demo/$name.gif"
            ls -lh "demo/$name.gif"
          done

      - name: Push the GIFs back to the branch
        id: push
        if: |
          steps.pick.outputs.names != '' &&
          (github.event_name == 'workflow_dispatch' ||
           github.event.pull_request.head.repo.full_name == github.repository)
        run: |
          set -euo pipefail
          git config user.name 'evergif'
          git config user.email 'evergif@users.noreply.github.com'
          # Stage first: `git diff` alone ignores untracked files.
          git add demo/*.gif
          if git diff --cached --quiet; then
            echo 'Rendered GIFs are identical to the committed ones; nothing to push.'
            exit 0
          fi
          git commit -m 'chore(evergif): render demo GIFs [skip ci]'
          git push origin "HEAD:${GITHUB_HEAD_REF:-${GITHUB_REF_NAME}}"
          echo 'Pushed the rendered GIFs to the branch.' >> "$GITHUB_STEP_SUMMARY"

      - name: Upload the GIFs for a fork pull request
        if: |
          steps.pick.outputs.names != '' &&
          github.event_name == 'pull_request' &&
          github.event.pull_request.head.repo.full_name != github.repository
        uses: actions/upload-artifact@v4
        with:
          name: evergif-gifs
          path: demo/*.gif
          if-no-files-found: error

      - name: Explain the fork artifact
        if: |
          steps.pick.outputs.names != '' &&
          github.event_name == 'pull_request' &&
          github.event.pull_request.head.repo.full_name != github.repository
        run: |
          {
            echo '### evergif rendered your demo GIFs'
            echo
            echo 'This pull request comes from a fork, so this workflow has a'
            echo 'read-only token and cannot push to your branch.'
            echo
            echo 'Download the **evergif-gifs** artifact from this run, drop the'
            echo 'files into `demo/`, and commit them to your branch.'
          } >> "$GITHUB_STEP_SUMMARY"

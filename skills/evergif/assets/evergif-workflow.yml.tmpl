name: evergif

on:
  push:
    branches: [__EVERGIF_BRANCH__]
    paths-ignore:
      - 'demo/*.gif'
      - 'demo/*.lock'
  schedule:
    - cron: '__EVERGIF_CRON__'
  workflow_dispatch:

permissions:
  contents: write

concurrency:
  group: evergif-${{ github.ref }}
  cancel-in-progress: true

env:
  VHS_NO_SANDBOX: 'true'

jobs:
  render:
    name: Refresh demo GIFs whose output changed
    # Pinned, not ubuntu-latest: a runner image change would alter the rendered
    # pixels and look like a demo that went stale.
    runs-on: ubuntu-24.04
    steps:
      - uses: actions/checkout@v7

      - name: Set up the project
        run: |
__EVERGIF_SETUP__

      - name: Which demos are stale?
        id: check
        run: |
          set -uo pipefail
          stale=''
          for tape in demo/*.tape; do
            [ -e "$tape" ] || continue
            name=$(basename "$tape" .tape)
            # The commands this demo shows: Type lines outside a Hide/Show block.
            commands=$(awk '
              /^Hide$/ {hidden = 1; next}
              /^Show$/ {hidden = 0; next}
              !hidden && /^Type / {
                line = substr($0, 6)
                print substr(line, 2, length(line) - 2)
              }' "$tape")
            path_add=$(grep -o 'PATH="[^"]*"' "$tape" | head -n 1 || true)
            transcript=$(
              if [ -n "$path_add" ]; then eval "export $path_add"; fi
              while IFS= read -r command; do
                [ -z "$command" ] && continue
                printf '$ %s\n' "$command"
                bash -c "$command" 2>&1
              done <<< "$commands"
            )
            new=$(printf '%s' "$transcript" | sha256sum | cut -d' ' -f1)
            old=$(cat "demo/$name.lock" 2>/dev/null || echo none)
            printf '%s' "$new" > "demo/$name.lock"
            if [ "$old" = "$new" ] && [ -f "demo/$name.gif" ]; then
              echo "$name: output unchanged, GIF still accurate"
            else
              echo "$name: output changed ($old -> $new), re-rendering"
              stale="$stale $name"
            fi
          done
          echo "stale=${stale# }" >> "$GITHUB_OUTPUT"

      - name: Install the render toolchain
        if: steps.check.outputs.stale != ''
        env:
          VHS_VERSION: '0.12.0'
          TTYD_VERSION: '1.7.7'
        run: |
          set -euo pipefail
          sudo apt-get update -qq
          sudo apt-get install -y -qq ffmpeg gifsicle fonts-jetbrains-mono
          curl -fsSL -o /tmp/ttyd \
            "https://github.com/tsl0922/ttyd/releases/download/${TTYD_VERSION}/ttyd.x86_64"
          sudo install -m 755 /tmp/ttyd /usr/local/bin/ttyd
          curl -fsSL -o /tmp/vhs.deb \
            "https://github.com/charmbracelet/vhs/releases/download/v${VHS_VERSION}/vhs_${VHS_VERSION}_amd64.deb"
          sudo dpkg -i /tmp/vhs.deb || sudo apt-get -f install -y -qq
          # vhs uses termenv, which strips colour when CI is set.
          echo 'CI=' >> "$GITHUB_ENV"
          echo 'COLORTERM=truecolor' >> "$GITHUB_ENV"
          vhs --version && ttyd --version

      - name: Render and optimize the stale demos
        if: steps.check.outputs.stale != ''
        env:
          STALE: ${{ steps.check.outputs.stale }}
        run: |
          set -euo pipefail
          for name in $STALE; do
            vhs "demo/$name.tape"
            if [ ! -f "demo/$name.gif" ]; then
              echo "::error::vhs produced no GIF for demo '$name'"
              exit 1
            fi
            gifsicle -O3 --lossy=80 --colors 128 --no-comments --no-names \
              --no-extensions -b "demo/$name.gif"
            ls -lh "demo/$name.gif"
          done

      # Committing straight to the branch needs only `contents: write`, which
      # every repository grants by default. Opening a pull request needs a
      # setting that is off by default, so that is opt-in (ci.py --pr).
      #<<commit
      - name: Commit the refreshed GIFs
        if: steps.check.outputs.stale != ''
        env:
          TARGET: ${{ github.ref_name }}
          SERVER: ${{ github.server_url }}
          REPO: ${{ github.repository }}
        run: |
          set -euo pipefail
          git config user.name 'evergif'
          git config user.email 'evergif@users.noreply.github.com'
          # Stage first: `git diff` alone ignores untracked files, so a brand
          # new demo's first GIF would look like "nothing to commit".
          git add demo/
          if git diff --cached --quiet; then
            echo 'Rendered output is identical to what is committed.'
            exit 0
          fi
          git commit -m 'chore(evergif): refresh demo GIFs [skip ci]'
          if git push origin "HEAD:$TARGET" 2>/dev/null; then
            echo "Refreshed the demo GIFs on \`$TARGET\`." >> "$GITHUB_STEP_SUMMARY"
          else
            git push --force origin 'HEAD:evergif/update'
            {
              echo '### evergif could not push to the default branch'
              echo
              echo 'It is probably protected. The refreshed GIFs are on the'
              echo "\`evergif/update\` branch instead:"
              echo
              echo "$SERVER/$REPO/compare/$TARGET...evergif/update?expand=1"
            } >> "$GITHUB_STEP_SUMMARY"
          fi

      #commit>>
      #<<pr
      - name: Open a pull request
        id: pr
        if: steps.check.outputs.stale != ''
        uses: peter-evans/create-pull-request@v8
        with:
          branch: evergif/update
          delete-branch: true
          add-paths: |
            demo/*.gif
            demo/*.lock
          commit-message: 'chore(evergif): refresh the demo GIFs'
          title: 'evergif: refresh the demo GIFs'
          body: |
            The commands in these demos now print something different, so their
            GIFs no longer match the CLI:

            **${{ steps.check.outputs.stale }}**

            Re-rendered from `demo/<name>.tape` by the evergif workflow.
          labels: evergif

      - name: Explain a failed pull request
        if: failure() && steps.pr.outcome == 'failure'
        run: |
          {
            echo '### evergif could not open a pull request'
            echo
            echo 'Pull requests from Actions are disabled for this repository.'
            echo 'Either enable **Settings -> Actions -> General -> Workflow**'
            echo '**permissions -> "Allow GitHub Actions to create and approve**'
            echo "**pull requests\"**, or re-run \`evergif --ci\` without \`--pr\` to"
            echo 'commit the refreshed GIFs directly instead.'
          } >> "$GITHUB_STEP_SUMMARY"
          echo 'evergif: PR creation is disabled for this repo; see the job summary.'
          exit 1
      #pr>>
  #<<web
  web:
    name: Refresh web demo GIFs
    runs-on: ubuntu-24.04
    steps:
      - uses: actions/checkout@v7

      - name: Set up the project
        run: |
__EVERGIF_SETUP__

      - name: Install Playwright and the conversion tools
        env:
          PLAYWRIGHT_VERSION: '1.63.0'
        run: |
          set -euo pipefail
          sudo apt-get update -qq
          sudo apt-get install -y -qq ffmpeg gifsicle
          npm install -g --silent "playwright@${PLAYWRIGHT_VERSION}"
          NODE_PATH="$(npm root -g)"
          echo "NODE_PATH=$NODE_PATH" >> "$GITHUB_ENV"
          # --with-deps pulls the browser's system libraries too.
          npx --yes "playwright@${PLAYWRIGHT_VERSION}" install --with-deps chromium

      - name: Record the web demos
        id: web
        run: |
          set -uo pipefail
          changed=''
          found=''
          echo "::notice::web demos found: $(printf '%s ' demo/*.web.mjs)"
          read_key() { python3 -c "import json,sys;print(json.load(open(sys.argv[1])).get(sys.argv[2]) or '')" "$1" "$2"; }
          for script in demo/*.web.mjs; do
            [ -e "$script" ] || continue
            name=$(basename "$script" .web.mjs)
            settings="demo/$name.web.json"
            url=$(read_key "$settings" url)
            serve=$(read_key "$settings" serve)
            webm=$(read_key "$settings" videoPath)
            transcript=$(read_key "$settings" transcriptPath)
            serve_pid=''
            if [ -n "$serve" ]; then
              bash -c "$serve" &
              serve_pid=$!
            fi
            ready=''
            for _ in $(seq 1 90); do
              if curl -sf -o /dev/null "$url"; then ready=yes; break; fi
              sleep 1
            done
            if [ -z "$ready" ]; then
              echo "::error::$url never answered for demo '$name'"
              [ -n "$serve_pid" ] && kill "$serve_pid" 2>/dev/null
              exit 1
            fi
            node "$script" 2>&1 | tee "/tmp/$name.log"
            status=${PIPESTATUS[0]}
            [ -n "$serve_pid" ] && kill "$serve_pid" 2>/dev/null
            if [ "$status" -ne 0 ] || [ ! -f "$webm" ]; then
              echo "::error::recording failed for demo '$name': $(tail -n 3 "/tmp/$name.log" | tr '\n' ' ')"
              exit 1
            fi
            ffmpeg -v error -y -i "$webm" -vf \
              "fps=12,scale=1000:-1:flags=lanczos,split[a][b];[a]palettegen=max_colors=256:stats_mode=diff[p];[b][p]paletteuse=dither=bayer:bayer_scale=5:diff_mode=rectangle" \
              -loop 0 "demo/$name.gif"
            gifsicle -O3 --lossy=80 --colors 128 --no-comments --no-names \
              --no-extensions -b "demo/$name.gif"
            rm -rf "$webm" "demo/.$name-video"
            new=$(sha256sum "$transcript" | cut -d' ' -f1)
            old=$(cat "demo/$name.lock" 2>/dev/null || echo none)
            if [ "$old" = "$new" ]; then
              echo "$name: page content unchanged, keeping the committed GIF"
              git checkout -- "demo/$name.gif" 2>/dev/null || true
            else
              echo "$name: page content changed ($old -> $new)"
              printf '%s' "$new" > "demo/$name.lock"
              changed="$changed $name"
            fi
            rm -f "$transcript"
            found="$found $name"
            echo "::notice::$name -> $(stat -c%s "demo/$name.gif") bytes, lock $new"
          done
          echo "::notice::processed:${found:- none} changed:${changed:- none}"
          echo "::notice::git status: $(git status --porcelain demo/ | tr '\n' ' ')"
          echo "changed=${changed# }" >> "$GITHUB_OUTPUT"

      - name: Commit the refreshed web GIFs
        if: steps.web.outputs.changed != ''
        env:
          TARGET: ${{ github.ref_name }}
        run: |
          set -euo pipefail
          git config user.name 'evergif'
          git config user.email 'evergif@users.noreply.github.com'
          git add demo/
          if git diff --cached --quiet; then
            echo 'Nothing to commit.'
            exit 0
          fi
          git commit -m 'chore(evergif): refresh web demo GIFs [skip ci]'
          git push origin "HEAD:$TARGET"
  #web>>

# Generated by evergif (https://github.com/ShreyasDasari/evergif).
# Re-run evergif to regenerate; CI renders this file as-is.
Output demo/evergif.gif

Set Shell "bash"
Set FontSize 18
Set Width 1100
Set Height 380
Set Padding 24
Set Theme "Catppuccin Mocha"
Set TypingSpeed 45ms
Set Framerate 24
Set CursorBlink false
Env BASH_SILENCE_DEPRECATION_WARNING "1"

Hide
Type `export PATH="$PWD/skills/evergif/scripts:$PATH" PS1='> ' PROMPT_COMMAND='' HISTFILE=/dev/null && clear`
Enter
Wait@10s
Show

Type 'embed.py --alt "Demo of the todo CLI" --readme examples/shcli/README.md --dry-run'
Sleep 400ms
Enter
Wait@15s
Sleep 3s

Hide
Type "clear"
Enter
Wait@10s
Show

Type 'tape.py --commands "todo --help; todo stats" --stdout | head -12'
Sleep 400ms
Enter
Wait@15s
Sleep 3s
